     "text": [
      "z(alpha_p) recomputed with survey-specific reference.\n",
      "   survey_id class_label  alpha_p_mean  alpha_p_ref  z_alpha_p\n",
      "0          1          S1     -0.142298    -0.098254  -0.541544\n",
      "1          2          S1     -0.232503    -0.258909   0.342602\n",
      "2          3          S1     -0.143991    -0.137433  -0.101753\n",
      "3          4          S1     -0.292324    -0.254516  -0.528100\n",
      "4          5          S1     -0.251407    -0.246539  -0.068411\n"
     ]
    }
   ],
   "source": [
    "# === Survey-specific reference for z(alpha_p) ===\n",
    "# alpha_p is defined at each survey's covariate means.\n",
    "# Full-catalog REFERENCE['alpha_p'] is at full-catalog means -> mismatch.\n",
    "# Recompute z(alpha_p) only; beta_p, beta_s, epsilon are centering-invariant.\n",
    "\n",
    "def _means(df_in):\n",
    "    x_m = df_in['logM'].to_numpy(float)\n",
    "    x_s = df_in['Star Metallicity'].to_numpy(float)\n",
    "    yp = df_in['log(X_H2O)'].to_numpy(float)\n",
    "    el_p = df_in['uncertainty_lower'].to_numpy(float)\n",
    "    eh_p = df_in['uncertainty_upper'].to_numpy(float)\n",
    "    el_s = df_in['Star Metallicity Error Lower'].to_numpy(float)\n",
    "    eh_s = df_in['Star Metallicity Error Upper'].to_numpy(float)\n",
    "\n",
    "    m = (\n",
    "        np.isfinite(x_m)\n",
    "        & np.isfinite(x_s)\n",
    "        & np.isfinite(yp)\n",
    "        & np.isfinite(el_p)\n",
    "        & np.isfinite(eh_p)\n",
    "        & np.isfinite(el_s)\n",
    "        & np.isfinite(eh_s)\n",
    "    )\n",
    "\n",
    "    return float(x_m[m].mean()), float(x_s[m].mean())\n",
    "\n",
    "\n",
    "mean_M_full, mean_S_full = _means(raw_df)\n",
    "survey_means = {s.survey_id: _means(s.df) for s in surveys}\n",
    "\n",
    "alpha_full = REFERENCE['alpha_p']\n",
    "beta_p_full = REFERENCE['beta_p']\n",
    "beta_s_full = REFERENCE['beta_s']\n",
    "\n",
    "\n",
    "def alpha_ref_for(sid):\n",
    "    mM, mS = survey_means[sid]\n",
    "    return (\n",
    "        alpha_full\n",
    "        + beta_p_full * (mM - mean_M_full)\n",
    "        + beta_s_full * (mS - mean_S_full)\n",
    "    )\n",
    "\n",
    "\n",
    "df_results['alpha_p_ref'] = df_results['survey_id'].map(alpha_ref_for)\n",
    "\n",
    "df_results['z_alpha_p'] = (\n",
    "    (df_results['alpha_p_mean'] - df_results['alpha_p_ref'])\n",
    "    / df_results['alpha_p_sd'].clip(lower=1e-10)\n",
    ")\n",
    "\n",
    "print('z(alpha_p) recomputed with survey-specific reference.')\n",
    "print(\n",
    "    df_results[\n",
    "        [\n",
    "            'survey_id',\n",
    "            'class_label',\n",
    "            'alpha_p_mean',\n",
    "            'alpha_p_ref',\n",
    "            'z_alpha_p',\n",
    "        ]\n",
    "    ].head()\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. WAIC Model Comparison\n",
    "\n",
    "$\\Delta$WAIC = elpd(full) $-$ elpd(variant). Positive = full model wins."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
