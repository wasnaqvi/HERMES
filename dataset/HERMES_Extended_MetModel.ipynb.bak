    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df_pw = df_results[\n",
    "    (df_results[\"model\"] == PRIMARY) & (df_results[\"seed\"] == MCMC_SEEDS[0])\n",
    "].copy()\n",
    "\n",
    "df_pw[\"sqrtN_Lm\"] = np.sqrt(df_pw[\"N\"]) * df_pw[\"L_mass\"]\n",
    "df_pw[\"sqrtN_Ls\"] = np.sqrt(df_pw[\"N\"]) * df_pw[\"L_stellar\"]\n",
    "\n",
    "sd_params = [\n",
    "    (\"beta_p_sd\", r\"$\\sigma_{\\beta_p}$\"),\n",
    "    (\"beta_s_sd\", r\"$\\sigma_{\\beta_s}$\"),\n",
    "    (\"alpha_p_sd\", r\"$\\sigma_{\\alpha_p}$\"),\n",
    "    (\"epsilon_sd\", r\"$\\sigma_{\\varepsilon}$\"),\n",
    "]\n",
    "sd_params = [(c, l) for c, l in sd_params if c in df_pw.columns]\n",
    "\n",
    "fig, axes = plt.subplots(\n",
    "    len(sd_params),\n",
    "    2,\n",
    "    figsize=(10.5, 3.8 * len(sd_params)),\n",
    "    squeeze=False,\n",
    ")\n",
    "\n",
    "for row, (sd_col, ylabel) in enumerate(sd_params):\n",
    "    for col_idx, (xcol, xlabel) in enumerate(\n",
    "        [\n",
    "            (\"sqrtN_Lm\", r\"$\\sqrt{N}\\;\\cdot\\;L_{\\mathrm{mass}}$\"),\n",
    "            (\"sqrtN_Ls\", r\"$\\sqrt{N}\\;\\cdot\\;L_{\\mathrm{stellar}}$\"),\n",
    "        ]\n",
    "    ):\n",
    "        ax = axes[row, col_idx]\n",
    "        x = df_pw[xcol].values\n",
    "        y = df_pw[sd_col].values\n",
    "        labels = df_pw[\"class_label\"].to_numpy(str)\n",
    "\n",
    "        scatter_fits(ax, x, y, labels, ylabel, xlabel)\n",
    "\n",
    "    add_legend(axes[row, 0], df_pw)\n",
    "\n",
    "fig.tight_layout()\n",
    "plt.savefig(\"sigma_vs_sqrtN_L.pdf\", bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
