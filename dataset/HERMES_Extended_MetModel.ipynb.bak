   "source": [
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patheffects as pe\n",
    "import numpy as np\n",
    "\n",
    "# Heatmap: detection fraction by (sigma, N)\n",
    "heat_piv = det_summary.pivot_table(index='N', columns='sigma', values='frac_detect')\n",
    "heat_piv = heat_piv.sort_index(ascending=False)  # largest N on top\n",
    "\n",
    "nrows, ncols = heat_piv.shape\n",
    "fig, ax = plt.subplots(figsize=(10, 4.5))\n",
    "\n",
    "cmap = plt.cm.YlGn\n",
    "norm = plt.Normalize(vmin=0, vmax=1)\n",
    "\n",
    "im = ax.imshow(heat_piv.values, aspect='auto', cmap=cmap, norm=norm)\n",
    "\n",
    "# Annotate cells with contrast-aware text color + outline\n",
    "for i in range(nrows):\n",
    "    for j in range(ncols):\n",
    "        val = heat_piv.values[i, j]\n",
    "        if np.isfinite(val):\n",
    "            r, g, b, _ = cmap(norm(val))\n",
    "            luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b\n",
    "            txt_color = 'white' if luminance < 0.52 else 'black'\n",
    "            outline_color = 'black' if txt_color == 'white' else 'white'\n",
    "            ax.text(j, i, f'{val:.0%}', ha='center', va='center',\n",
    "                    fontsize=10, fontweight='bold', color=txt_color,\n",
    "                    path_effects=[pe.withStroke(linewidth=1.2, foreground=outline_color)])\n",
    "\n",
    "ax.set_xticks(range(ncols))\n",
    "ax.set_xticklabels([f'{s:.1f}' for s in heat_piv.columns], fontsize=10)\n",
    "ax.set_yticks(range(nrows))\n",
    "ax.set_yticklabels([str(int(n)) for n in heat_piv.index], fontsize=10)\n",
    "\n",
    "ax.set_xlabel(r'Intrinsic scatter in planetary metallicity $\\epsilon$ (dex)', fontsize=14)\n",
    "ax.set_ylabel('Number of Planets in Survey', fontsize=14)\n",
    "# ax.set_title('Stellar metallicity detection rate by scatter and sample size', fontsize=14)\n",
    "\n",
    "cbar = fig.colorbar(im, ax=ax, shrink=0.85)\n",
    "cbar.set_label('Star-Planet Metallicity Correlation Sensitivity', fontsize=12)\n",
    "\n",
    "fig.tight_layout()      \n",
    "plt.savefig('scatter_threshold_heatmap_no_title.pdf', bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
