     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=================================================================\n",
      "2D decomposition: σ_θ = a · N^γ_N · σ_x^γ_σ\n",
      "   σ_x = L_relevant / √N  (per-planet diversity)\n",
      "   Ideal OLS: γ_N = −0.50, γ_σ = −1.00\n",
      "=================================================================\n",
      "               Param        L axis             γ_N             γ_σ      R²\n",
      "-----------------------------------------------------------------\n",
      "  $\\sigma_{\\beta_p}$        L_mass  -0.53 ± 0.02  -1.24 ± 0.07  0.889\n",
      "  $\\sigma_{\\beta_s}$     L_stellar  -0.53 ± 0.01  -0.24 ± 0.05  0.949\n",
      " $\\sigma_{\\alpha_p}$        L_mass  -0.51 ± 0.01  +0.15 ± 0.02  0.974\n",
      "$\\sigma_{\\varepsilon}$        L_mass  -0.54 ± 0.01  -0.02 ± 0.02  0.985\n"
     ]
    }
   ],
   "source": [
    "# ── σ_θ vs L, coloured by class (S1–S4), one row per parameter ─────\n",
    "# Each row: left = vs L_mass, right = vs L_stellar\n",
    "# Points from ALL N values pooled; marker SIZE encodes N.\n",
    "# Uses the same HERMES style (CLS_CLR, scatter_fits conventions).\n",
    "# The 2D power-law decomposition γ_N, γ_σ is annotated.\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.lines import Line2D\n",
    "\n",
    "df_pw = df_results[\n",
    "    (df_results[\"model\"] == PRIMARY) & (df_results[\"seed\"] == MCMC_SEEDS[0])\n",
    "].copy()\n",
    "\n",
    "# Per-planet diversity\n",
    "df_pw[\"sigma_mass\"] = df_pw[\"L_mass\"] / np.sqrt(df_pw[\"N\"])\n",
    "df_pw[\"sigma_stellar\"] = df_pw[\"L_stellar\"] / np.sqrt(df_pw[\"N\"])\n",
    "\n",
    "\n",
    "# ── 2D power-law fitter ──────────────────────────────────────────────\n",
    "def _fit_2d(y, N, sx):\n",
    "    m = np.isfinite(y) & (y > 0) & (N > 0) & (sx > 0)\n",
    "\n",
    "    ly = np.log(y[m])\n",
    "    lN = np.log(N[m])\n",
    "    ls = np.log(sx[m])\n",
    "\n",
    "    A = np.vstack([np.ones(m.sum()), lN, ls]).T\n",
    "    b = np.linalg.lstsq(A, ly, rcond=None)[0]\n",
    "\n",
    "    r = ly - A @ b\n",
    "    s2 = np.dot(r, r) / max(len(ly) - 3, 1)\n",
    "    cov = s2 * np.linalg.inv(A.T @ A)\n",
    "    se = np.sqrt(np.diag(cov))\n",
    "\n",
    "    ss_res = np.sum(r**2)\n",
    "    ss_tot = np.sum((ly - ly.mean()) ** 2)\n",
    "\n",
    "    return dict(\n",
    "        a=b[0],\n",
    "        gN=b[1],\n",
    "        seN=se[1],\n",
    "        gS=b[2],\n",
    "        seS=se[2],\n",
    "        R2=1 - ss_res / ss_tot,\n",
    "    )\n",
    "\n",
    "\n",
    "# ── config ───────────────────────────────────────────────────────────\n",
    "params = [\n",
    "    (\n",
    "        \"beta_p_sd\",\n",
    "        r\"$\\sigma_{\\beta_p}$\",\n",
    "        \"L_mass\",\n",
    "        \"sigma_mass\",\n",
    "        r\"$L_{\\mathrm{mass}}$\",\n",
    "    ),\n",
    "    (\n",
    "        \"beta_s_sd\",\n",
    "        r\"$\\sigma_{\\beta_s}$\",\n",
    "        \"L_stellar\",\n",
    "        \"sigma_stellar\",\n",
    "        r\"$L_{\\mathrm{stellar}}$\",\n",
    "    ),\n",
    "    (\n",
    "        \"alpha_p_sd\",\n",
    "        r\"$\\sigma_{\\alpha_p}$\",\n",
    "        \"L_mass\",\n",
    "        \"sigma_mass\",\n",
    "        r\"$L_{\\mathrm{mass}}$\",\n",
    "    ),\n",
    "    (\n",
    "        \"epsilon_sd\",\n",
    "        r\"$\\sigma_{\\varepsilon}$\",\n",
    "        \"L_mass\",\n",
    "        \"sigma_mass\",\n",
    "        r\"$L_{\\mathrm{mass}}$\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "params = [(c, l, lc, sc, lx) for c, l, lc, sc, lx in params if c in df_pw.columns]\n",
    "\n",
    "# Marker size encodes N: smallest N → smallest dot\n",
    "N_vals = sorted(df_pw[\"N\"].unique())\n",
    "size_map = {\n",
    "    n: 12 + 38 * i / (len(N_vals) - 1)\n",
    "    for i, n in enumerate(N_vals)\n",
    "}\n",
    "\n",
    "fig, axes = plt.subplots(\n",
    "    len(params),\n",
    "    2,\n",
    "    figsize=(11, 3.6 * len(params)),\n",
    "    squeeze=False,\n",
    ")\n",
    "\n",
    "for row, (sd_col, ylabel, lev_col, sig_col, xlabel) in enumerate(params):\n",
    "    y = df_pw[sd_col].values\n",
    "    x_L = df_pw[lev_col].values\n",
    "    N = df_pw[\"N\"].values\n",
    "    sx = df_pw[sig_col].values\n",
    "    labels = df_pw[\"class_label\"].values\n",
    "\n",
    "    fit = _fit_2d(y, N, sx)\n",
    "\n",
    "    for col_idx, (xdata, xlab) in enumerate(\n",
    "        [\n",
    "            (df_pw[\"L_mass\"].values, r\"$L_{\\mathrm{mass}}$\"),\n",
    "            (df_pw[\"L_stellar\"].values, r\"$L_{\\mathrm{stellar}}$\"),\n",
    "        ]\n",
    "    ):\n",
    "        ax = axes[row, col_idx]\n",
    "\n",
    "        m = np.isfinite(xdata) & np.isfinite(y) & (xdata > 0) & (y > 0)\n",
    "\n",
    "        # Scatter coloured by class, sized by N.\n",
    "        for cls in CLS_ORD:\n",
    "            cm = (labels == cls) & m\n",
    "\n",
    "            if not cm.any():\n",
    "                continue\n",
    "\n",
    "            sizes = np.array([size_map[n] for n in N[cm]])\n",
    "\n",
    "            ax.scatter(\n",
    "                xdata[cm],\n",
    "                y[cm],\n",
    "                s=sizes,\n",
    "                alpha=0.9,\n",
    "                color=CLS_CLR.get(cls, \"k\"),\n",
    "                label=cls,\n",
    "            )\n",
    "\n",
    "        # 1D power-law band, same as existing scatter_fits.\n",
    "        xf = xdata[m]\n",
    "        yf = y[m]\n",
    "\n",
    "        if xf.size >= 2:\n",
    "            xg = np.linspace(xf.min() * 0.98, xf.max() * 1.02, 200)\n",
    "            yh, lo, hi = _pl_band(xf, yf, xg)\n",
    "\n",
    "            ax.fill_between(xg, lo, hi, alpha=0.15, linewidth=0)\n",
    "            ax.plot(xg, yh, ls=\"--\", lw=1.2)\n",
    "\n",
    "            b_exp, b_err = _pl_fit_unc(xf, yf)\n",
    "            sym = ylabel.strip().strip(\"$\")\n",
    "\n",
    "            ann = (\n",
    "                rf\"${sym} \\propto L^{{{b_exp:.2f}\"\n",
    "                rf\"\\;^{{+{b_err:.2f}}}_{{-{b_err:.2f}}}}}$\"\n",
    "            )\n",
    "\n",
    "            ax.text(\n",
    "                0.05,\n",
    "                0.95,\n",
    "                ann,\n",
    "                transform=ax.transAxes,\n",
    "                fontsize=12,\n",
    "                va=\"top\",\n",
    "            )\n",
    "\n",
    "        ax.set_xlabel(xlab)\n",
    "        ax.set_ylabel(ylabel)\n",
    "        ax.minorticks_on()\n",
    "\n",
    "    # 2D decomposition annotation on LEFT panel only.\n",
    "    ann2d = (\n",
    "        rf'$\\gamma_N = {fit[\"gN\"]:.2f} \\pm {fit[\"seN\"]:.2f}$'\n",
    "        \"\\n\"\n",
    "        rf'$\\gamma_{{\\sigma}} = {fit[\"gS\"]:.2f} \\pm {fit[\"seS\"]:.2f}$'\n",
    "    )\n",
    "\n",
    "    axes[row, 0].text(\n",
    "        0.05,\n",
    "        0.72,\n",
    "        ann2d,\n",
    "        transform=axes[row, 0].transAxes,\n",
    "        fontsize=10,\n",
    "        va=\"top\",\n",
    "        color=\"0.3\",\n",
    "    )\n",
    "\n",
    "# Legend: class colours.\n",
    "add_legend(axes[0, 0], df_pw)\n",
    "\n",
    "# Legend: N sizes, bottom-right panel.\n",
    "size_handles = [\n",
    "    Line2D(\n",
    "        [],\n",
    "        [],\n",
    "        ls=\"none\",\n",
    "        marker=\"o\",\n",
    "        ms=np.sqrt(size_map[n]),\n",
    "        color=\"0.5\",\n",
    "        markeredgecolor=\"none\",\n",
    "    )\n",
    "    for n in [50, 200, 400, 600]\n",
    "    if n in N_vals\n",
    "]\n",
    "\n",
    "size_labels = [f\"$N={n}$\" for n in [50, 200, 400, 600] if n in N_vals]\n",
    "\n",
    "axes[-1, 1].legend(\n",
    "    size_handles,\n",
    "    size_labels,\n",
    "    fontsize=9,\n",
    "    loc=\"upper right\",\n",
    "    title=\"Sample size\",\n",
    "    title_fontsize=9,\n",
    "    frameon=False,\n",
    ")\n",
    "\n",
    "fig.tight_layout()\n",
    "plt.savefig(\"sigma_vs_L_decomposition.svg\", bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ── print 2D decomposition table ────────────────────────────────────\n",
    "print(\"=\" * 65)\n",
    "print(\"2D decomposition: σ_θ = a · N^γ_N · σ_x^γ_σ\")\n",
    "print(\"   σ_x = L_relevant / √N  (per-planet diversity)\")\n",
    "print(\"   Ideal OLS: γ_N = −0.50, γ_σ = −1.00\")\n",
    "print(\"=\" * 65)\n",
    "\n",
    "fmt = (\n",
    "    f'{\"Param\":>20s}  {\"L axis\":>12s}  {\"γ_N\":>14s}  '\n",
    "    f'{\"γ_σ\":>14s}  {\"R²\":>6s}'\n",
    ")\n",
    "\n",
    "print(fmt)\n",
    "print(\"-\" * 65)\n",
    "\n",
    "for sd_col, ylabel, lev_col, sig_col, _ in params:\n",
    "    fit = _fit_2d(\n",
    "        df_pw[sd_col].values,\n",
    "        df_pw[\"N\"].values,\n",
    "        df_pw[sig_col].values,\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"{ylabel:>20s}  {lev_col:>12s}  \"\n",
    "        f'{fit[\"gN\"]:+.2f} ± {fit[\"seN\"]:.2f}  '\n",
    "        f'{fit[\"gS\"]:+.2f} ± {fit[\"seS\"]:.2f}  '\n",
    "        f'{fit[\"R2\"]:.3f}'\n",
    "    )"
   ]
  },
