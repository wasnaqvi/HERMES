   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "try:\n",
    "    df = df_results.copy()\n",
    "except NameError:\n",
    "    df = pd.read_csv(\"hermes_extended_results.csv\")\n",
    "\n",
    "PRIMARY_MODEL = \"3D Model\"\n",
    "SEED0 = MCMC_SEEDS[0] if \"MCMC_SEEDS\" in globals() else 321\n",
    "\n",
    "df_tab = df[\n",
    "    (df[\"model\"] == PRIMARY_MODEL) &\n",
    "    (df[\"seed\"] == SEED0)\n",
    "].copy()\n",
    "\n",
    "# Image #1 x-axes\n",
    "df_tab[\"sigma_logM\"] = df_tab[\"L_mass\"] / np.sqrt(df_tab[\"N\"])\n",
    "df_tab[\"sigma_FeH\"] = df_tab[\"L_stellar\"] / np.sqrt(df_tab[\"N\"])\n",
    "\n",
    "df_tab[\"sqrtN_sigma_logM\"] = (\n",
    "    np.sqrt(df_tab[\"N\"]) * df_tab[\"sigma_logM\"]\n",
    ")\n",
    "\n",
    "df_tab[\"sqrtN_sigma_FeH\"] = (\n",
    "    np.sqrt(df_tab[\"N\"]) * df_tab[\"sigma_FeH\"]\n",
    ")\n",
    "\n",
    "param_specs = [\n",
    "    (\"alpha_p_sd\", r\"$\\sigma_{\\alpha_p}$\"),\n",
    "    (\"beta_p_sd\", r\"$\\sigma_{\\beta_p}$\"),\n",
    "    (\"beta_s_sd\", r\"$\\sigma_{\\beta_s}$\"),\n",
    "    (\"epsilon_sd\", r\"$\\sigma_{\\varepsilon}$\"),\n",
    "]\n",
    "\n",
    "param_specs = [\n",
    "    (c, l)\n",
    "    for c, l in param_specs\n",
    "    if c in df_tab.columns\n",
    "]\n",
    "\n",
    "\n",
    "def powerlaw_exponent(x, y):\n",
    "    x = np.asarray(x, float)\n",
    "    y = np.asarray(y, float)\n",
    "\n",
    "    m = np.isfinite(x) & np.isfinite(y) & (x > 0) & (y > 0)\n",
    "\n",
    "    x = x[m]\n",
    "    y = y[m]\n",
    "\n",
    "    lx = np.log(x)\n",
    "    ly = np.log(y)\n",
    "\n",
    "    A = np.vstack([np.ones_like(lx), lx]).T\n",
    "\n",
    "    beta = np.linalg.lstsq(\n",
    "        A,\n",
    "        ly,\n",
    "        rcond=None,\n",
    "    )[0]\n",
    "\n",
    "    resid = ly - A @ beta\n",
    "\n",
    "    n, p = A.shape\n",
    "    dof = max(n - p, 1)\n",
    "\n",
    "    s2 = float(resid @ resid / dof)\n",
    "\n",
    "    cov = s2 * np.linalg.pinv(A.T @ A)\n",
    "    err = np.sqrt(np.diag(cov))\n",
    "\n",
    "    r2 = (\n",
    "        1.0\n",
    "        - float(resid @ resid)\n",
    "        / float((ly - ly.mean()) @ (ly - ly.mean()))\n",
    "    )\n",
    "\n",
    "    return beta[1], err[1], r2, n\n",
    "\n",
    "\n",
    "rows = []\n",
    "\n",
    "for y_col, label in param_specs:\n",
    "    gamma_M, err_M, r2_M, n_M = powerlaw_exponent(\n",
    "        df_tab[\"sqrtN_sigma_logM\"],\n",
    "        df_tab[y_col],\n",
    "    )\n",
    "\n",
    "    gamma_FeH, err_FeH, r2_FeH, n_FeH = powerlaw_exponent(\n",
    "        df_tab[\"sqrtN_sigma_FeH\"],\n",
    "        df_tab[y_col],\n",
    "    )\n",
    "\n",
    "    rows.append({\n",
    "        \"Parameter\": label,\n",
    "        r\"$\\gamma_M$\": rf\"${gamma_M:+.2f}\\pm{err_M:.2f}$\",\n",
    "        r\"$R^2_M$\": f\"{r2_M:.2f}\",\n",
    "        r\"$\\gamma_\\star$\": rf\"${gamma_FeH:+.2f}\\pm{err_FeH:.2f}$\",\n",
    "        r\"$R^2_\\star$\": f\"{r2_FeH:.2f}\",\n",
    "        r\"$n$\": n_M,\n",
    "    })\n",
    "\n",
    "sqrtN_sigma_table = pd.DataFrame(rows)\n",
    "\n",
    "display(sqrtN_sigma_table)\n",
    "\n",
    "print(\n",
    "    sqrtN_sigma_table.to_latex(\n",
    "        index=False,\n",
    "        escape=False,\n",
    "        column_format=\"lccccc\",\n",
    "    )\n",
    ")"
   ]
  },
