  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10.5 Best Survey Per Class: Fit Reconstruction\n",
    "\n",
    "For each survey class (S1–S4), the survey with the smallest $|z_{\\beta_p}|$\n",
    "is selected. The Bayesian fit is reconstructed from fresh MCMC posterior\n",
    "samples, showing:\n",
    "- **Left**: $\\log M$ (centered) vs $\\log(X_{\\mathrm{H_2O}})$ with posterior trend + 68% credible band\n",
    "- **Right**: Star Metallicity (centered) vs $\\log(X_{\\mathrm{H_2O}})$ with posterior trend + 68% credible band\n",
    "\n",
    "A table of planet names for each best survey follows."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Best survey per class (smallest |z_beta_p|):\n",
      "  S1: Survey 7, N=80, z(beta_p)=+0.022\n",
      "  S4: Survey 126, N=50, z(beta_p)=-0.078\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1430x585 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1430x585 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "target_classes = [\"S1\", \"S4\"]\n",
    "\n",
    "# Ensure z-scores exist in df_results\n",
    "if \"z_beta_p\" not in df_results.columns:\n",
    "    if \"REFERENCE\" not in dir() and \"GROUND_TRUTH\" in dir() and GROUND_TRUTH is not None:\n",
    "        REFERENCE = GROUND_TRUTH\n",
    "\n",
    "    if \"REFERENCE\" in dir():\n",
    "        for p in [\"alpha_p\", \"beta_p\", \"beta_s\", \"epsilon\"]:\n",
    "            mc, sc = f\"{p}_mean\", f\"{p}_sd\"\n",
    "            if mc in df_results.columns and sc in df_results.columns:\n",
    "                df_results[f\"z_{p}\"] = (\n",
    "                    df_results[mc] - REFERENCE[p]\n",
    "                ) / df_results[sc].clip(lower=1e-10)\n",
    "    else:\n",
    "        raise RuntimeError(\n",
    "            \"REFERENCE not defined. Run the oracle / z-score cell first.\"\n",
    "        )\n",
    "\n",
    "# Select best survey per class: smallest |z_beta_p|\n",
    "df_best_sel = df_results[\n",
    "    (df_results[\"model\"] == PRIMARY)\n",
    "    & (df_results[\"seed\"] == MCMC_SEEDS[0])\n",
    "    & (df_results[\"class_label\"].isin(target_classes))\n",
    "].copy()\n",
    "\n",
    "df_best_sel[\"abs_z_beta_p\"] = df_best_sel[\"z_beta_p\"].abs()\n",
    "\n",
    "best_idx = df_best_sel.groupby(\"class_label\")[\"abs_z_beta_p\"].idxmin()\n",
    "best_rows = df_best_sel.loc[best_idx].sort_values(\"class_label\")\n",
    "\n",
    "survey_lookup = {sv.survey_id: sv for sv in surveys}\n",
    "\n",
    "print(\"Best survey per class (smallest |z_beta_p|):\")\n",
    "for _, row in best_rows.iterrows():\n",
    "    sv = survey_lookup[int(row[\"survey_id\"])]\n",
    "    print(\n",
    "        f\"  {sv.class_label}: Survey {int(row['survey_id'])}, \"\n",
    "        f\"N={sv.n}, z(beta_p)={row['z_beta_p']:+.3f}\"\n",
    "    )\n",
    "\n",
    "# Fixed axis limits\n",
    "mass_xlim = (-0.4, 0.6)\n",
    "star_xlim = (-0.4, 0.6)\n",
    "y_ylim = (-3.5, 0.5)\n",
    "\n",
    "for _, row in best_rows.iterrows():\n",
    "    sv = survey_lookup[int(row[\"survey_id\"])]\n",
    "    df_sv = sv.df\n",
    "\n",
    "    # Data\n",
    "    x_m = df_sv[\"logM\"].to_numpy(float)\n",
    "    x_s = df_sv[\"Star Metallicity\"].to_numpy(float)\n",
    "    y = df_sv[\"log(X_H2O)\"].to_numpy(float)\n",
    "\n",
    "    el_p = df_sv[\"uncertainty_lower\"].to_numpy(float)\n",
    "    eh_p = df_sv[\"uncertainty_upper\"].to_numpy(float)\n",
    "    yerr = np.clip(0.5 * (np.abs(el_p) + np.abs(eh_p)), 1e-6, None)\n",
    "\n",
    "    el_s = df_sv[\"Star Metallicity Error Lower\"].to_numpy(float)\n",
    "    eh_s = df_sv[\"Star Metallicity Error Upper\"].to_numpy(float)\n",
    "    xerr_s = np.clip(0.5 * (np.abs(el_s) + np.abs(eh_s)), 1e-6, None)\n",
    "\n",
    "    # Fit\n",
    "    mkw_best = prepare_model_kwargs(df_sv, USE_LOG_SPACE)\n",
    "    idata_best = fit_model(\n",
    "        met_model_full,\n",
    "        mkw_best,\n",
    "        MCMC_SEEDS[0],\n",
    "        DRAWS,\n",
    "        TUNE,\n",
    "        TARGET_ACCEPT,\n",
    "        NUM_CHAINS,\n",
    "    )\n",
    "\n",
    "    # Posterior samples\n",
    "    a = np.asarray(idata_best.posterior[\"alpha_p\"]).reshape(-1)\n",
    "    bp = np.asarray(idata_best.posterior[\"beta_p\"]).reshape(-1)\n",
    "    bs = np.asarray(idata_best.posterior[\"beta_s\"]).reshape(-1)\n",
    "\n",
    "    # Center predictors\n",
    "    x_m_c = x_m - float(np.mean(x_m))\n",
    "    x_s_c = x_s - float(np.mean(x_s))\n",
    "\n",
    "    # Fixed grids\n",
    "    m_grid = np.linspace(mass_xlim[0], mass_xlim[1], 250)\n",
    "    s_grid = np.linspace(star_xlim[0], star_xlim[1], 250)\n",
    "\n",
    "    # Posterior conditional trends\n",
    "    mu_m = a[:, None] + bp[:, None] * m_grid[None, :]\n",
    "    mu_s = a[:, None] + bs[:, None] * s_grid[None, :]\n",
    "\n",
    "    m_med = np.median(mu_m, axis=0)\n",
    "    m_lo = np.quantile(mu_m, 0.16, axis=0)\n",
    "    m_hi = np.quantile(mu_m, 0.84, axis=0)\n",
    "\n",
    "    s_med = np.median(mu_s, axis=0)\n",
    "    s_lo = np.quantile(mu_s, 0.16, axis=0)\n",
    "    s_hi = np.quantile(mu_s, 0.84, axis=0)\n",
    "\n",
    "    # Plot\n",
    "    fig, axes = plt.subplots(\n",
    "        1,\n",
    "        2,\n",
    "        figsize=(11, 4.5),\n",
    "        constrained_layout=True,\n",
    "    )\n",
    "\n",
    "    fig.suptitle(\n",
    "        rf\"{sv.class_label} | N={sv.n} | $z(\\beta_p)={row['z_beta_p']:+.3f}$\",\n",
    "        fontsize=12,\n",
    "    )\n",
    "\n",
    "    # Left panel: log(H2O) vs logM/Mj\n",
    "    ax = axes[0]\n",
    "    ax.errorbar(\n",
    "        x_m_c,\n",
    "        y,\n",
    "        yerr=yerr,\n",
    "        fmt=\"o\",\n",
    "        ms=4,\n",
    "        alpha=0.85,\n",
    "        capsize=2,\n",
    "        lw=0.9,\n",
    "        color=CLS_CLR.get(sv.class_label, \"C0\"),\n",
    "    )\n",
    "    ax.plot(m_grid, m_med, \"k-\", lw=1.5, label=\"Posterior median\")\n",
    "    ax.fill_between(m_grid, m_lo, m_hi, alpha=0.25, color=\"grey\", label=\"68% CI\")\n",
    "    ax.set_xlim(mass_xlim)\n",
    "    ax.set_ylim(y_ylim)\n",
    "    ax.set_xlabel(r\"$\\log(M/M_J)$\", fontsize=14)\n",
    "    ax.set_ylabel(r\"$\\log(X_{\\mathrm{H_2O}})$\", fontsize=14)\n",
    "    ax.legend(fontsize=12, frameon=False)\n",
    "    ax.minorticks_on()\n",
    "\n",
    "    # Right panel: log(H2O) vs stellar metallicity\n",
    "    ax = axes[1]\n",
    "    ax.errorbar(\n",
    "        x_s_c,\n",
    "        y,\n",
    "        yerr=yerr,\n",
    "        xerr=xerr_s,\n",
    "        fmt=\"o\",\n",
    "        ms=4,\n",
    "        alpha=0.85,\n",
    "        capsize=2,\n",
    "        lw=0.9,\n",
    "        color=CLS_CLR.get(sv.class_label, \"C0\"),\n",
    "    )\n",
    "    ax.plot(s_grid, s_med, \"k-\", lw=1.5, label=\"Posterior median\")\n",
    "    ax.fill_between(s_grid, s_lo, s_hi, alpha=0.25, color=\"grey\", label=\"68% CI\")\n",
    "    ax.set_xlim(star_xlim)\n",
    "    ax.set_ylim(y_ylim)\n",
    "    ax.set_xlabel(r\"Stellar metallicity (dex)\", fontsize=14)\n",
    "    ax.set_ylabel(r\"$\\log(X_{\\mathrm{H_2O}})$\", fontsize=14)\n",
    "    ax.minorticks_on()\n",
    "\n",
    "    plt.savefig(f\"best_survey_{sv.class_label}.svg\", bbox_inches=\"tight\")\n",
    "    plt.show()"
   ]
  },
