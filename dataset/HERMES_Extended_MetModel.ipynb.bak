   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "try:\n",
    "    df = df_results.copy()\n",
    "\n",
    "except NameError:\n",
    "    df = pd.read_csv(\"hermes_extended_results.csv\")\n",
    "\n",
    "PRIMARY_MODEL = \"3D Model\"\n",
    "\n",
    "SEED0 = (\n",
    "    MCMC_SEEDS[0]\n",
    "    if \"MCMC_SEEDS\" in globals()\n",
    "    else 321\n",
    ")\n",
    "\n",
    "df_tab = df[\n",
    "    (df[\"model\"] == PRIMARY_MODEL) &\n",
    "    (df[\"seed\"] == SEED0)\n",
    "].copy()\n",
    "\n",
    "df_tab[\"sigma_logM\"] = (\n",
    "    df_tab[\"L_mass\"] / np.sqrt(df_tab[\"N\"])\n",
    ")\n",
    "\n",
    "df_tab[\"sigma_FeH\"] = (\n",
    "    df_tab[\"L_stellar\"] / np.sqrt(df_tab[\"N\"])\n",
    ")\n",
    "\n",
    "param_specs = [\n",
    "    (\"alpha_p_sd\", r\"$\\sigma_{\\alpha_p}$\"),\n",
    "    (\"beta_p_sd\", r\"$\\sigma_{\\beta_p}$\"),\n",
    "    (\"beta_s_sd\", r\"$\\sigma_{\\beta_s}$\"),\n",
    "    (\"epsilon_sd\", r\"$\\sigma_{\\varepsilon}$\"),\n",
    "]\n",
    "\n",
    "param_specs = [\n",
    "    (c, l)\n",
    "    for c, l in param_specs\n",
    "    if c in df_tab.columns\n",
    "]\n",
    "\n",
    "\n",
    "def fit_scaling(data, y_col):\n",
    "\n",
    "    cols = [\n",
    "        y_col,\n",
    "        \"N\",\n",
    "        \"sigma_logM\",\n",
    "        \"sigma_FeH\",\n",
    "    ]\n",
    "\n",
    "    sub = (\n",
    "        data[cols]\n",
    "        .replace([np.inf, -np.inf], np.nan)\n",
    "        .dropna()\n",
    "    )\n",
    "\n",
    "    for c in cols:\n",
    "        sub = sub[sub[c] > 0]\n",
    "\n",
    "    y = np.log(\n",
    "        sub[y_col].to_numpy(float)\n",
    "    )\n",
    "\n",
    "    X = np.column_stack([\n",
    "        np.ones(len(sub)),\n",
    "\n",
    "        np.log(\n",
    "            sub[\"N\"].to_numpy(float)\n",
    "        ),\n",
    "\n",
    "        np.log(\n",
    "            sub[\"sigma_logM\"].to_numpy(float)\n",
    "        ),\n",
    "\n",
    "        np.log(\n",
    "            sub[\"sigma_FeH\"].to_numpy(float)\n",
    "        ),\n",
    "    ])\n",
    "\n",
    "    beta = np.linalg.lstsq(\n",
    "        X,\n",
    "        y,\n",
    "        rcond=None,\n",
    "    )[0]\n",
    "\n",
    "    resid = y - X @ beta\n",
    "\n",
    "    n, p = X.shape\n",
    "\n",
    "    dof = max(n - p, 1)\n",
    "\n",
    "    s2 = float(\n",
    "        resid @ resid / dof\n",
    "    )\n",
    "\n",
    "    cov = s2 * np.linalg.pinv(X.T @ X)\n",
    "\n",
    "    err = np.sqrt(\n",
    "        np.diag(cov)\n",
    "    )\n",
    "\n",
    "    r2 = (\n",
    "        1.0\n",
    "        - float(resid @ resid)\n",
    "        / float(\n",
    "            (y - y.mean()) @ (y - y.mean())\n",
    "        )\n",
    "    )\n",
    "\n",
    "    return beta, err, r2, np.sqrt(s2), n\n",
    "\n",
    "\n",
    "rows = []\n",
    "\n",
    "for y_col, label in param_specs:\n",
    "\n",
    "    beta, err, r2, rms, n = fit_scaling(\n",
    "        df_tab,\n",
    "        y_col,\n",
    "    )\n",
    "\n",
    "    rows.append({\n",
    "        \"Parameter\": label,\n",
    "\n",
    "        r\"$a_N$\":\n",
    "            rf\"${beta[1]:+.2f}\\pm{err[1]:.2f}$\",\n",
    "\n",
    "        r\"$a_M$\":\n",
    "            rf\"${beta[2]:+.2f}\\pm{err[2]:.2f}$\",\n",
    "\n",
    "        r\"$a_\\star$\":\n",
    "            rf\"${beta[3]:+.2f}\\pm{err[3]:.2f}$\",\n",
    "\n",
    "        r\"$R^2$\":\n",
    "            f\"{r2:.2f}\",\n",
    "\n",
    "        r\"RMS$_{\\log}$\":\n",
    "            f\"{rms:.2f}\",\n",
    "\n",
    "        r\"$n$\":\n",
    "            n,\n",
    "    })\n",
    "\n",
    "orthogonal_scaling_table = pd.DataFrame(rows)\n",
    "\n",
    "display(orthogonal_scaling_table)\n",
    "\n",
    "print(\n",
    "    orthogonal_scaling_table.to_latex(\n",
    "        index=False,\n",
    "        escape=False,\n",
    "        column_format=\"lcccccc\",\n",
    "    )\n",
    ")"
   ]
  },
