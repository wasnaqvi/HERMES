   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "try:\n",
    "    df = df_results.copy()\n",
    "\n",
    "except NameError:\n",
    "    df = pd.read_csv(\"hermes_extended_results.csv\")\n",
    "\n",
    "PRIMARY_MODEL = \"3D Model\"\n",
    "\n",
    "SEED0 = (\n",
    "    MCMC_SEEDS[0]\n",
    "    if \"MCMC_SEEDS\" in globals()\n",
    "    else 321\n",
    ")\n",
    "\n",
    "df_plot = df[\n",
    "    (df[\"model\"] == PRIMARY_MODEL) &\n",
    "    (df[\"seed\"] == SEED0)\n",
    "].copy()\n",
    "\n",
    "# Recover per-survey standard deviations from leverage.\n",
    "df_plot[\"sigma_logM\"] = (\n",
    "    df_plot[\"L_mass\"] / np.sqrt(df_plot[\"N\"])\n",
    ")\n",
    "\n",
    "df_plot[\"sigma_FeH\"] = (\n",
    "    df_plot[\"L_stellar\"] / np.sqrt(df_plot[\"N\"])\n",
    ")\n",
    "\n",
    "# Define the plotted information metrics.\n",
    "df_plot[\"X_M\"] = (\n",
    "    np.sqrt(df_plot[\"N\"]) * df_plot[\"sigma_logM\"]\n",
    ")\n",
    "\n",
    "df_plot[\"X_star\"] = (\n",
    "    np.sqrt(df_plot[\"N\"]) * df_plot[\"sigma_FeH\"]\n",
    ")\n",
    "\n",
    "param_specs = [\n",
    "    (\"alpha_p_sd\", r\"$\\sigma_{\\alpha_p}$\"),\n",
    "    (\"beta_p_sd\", r\"$\\sigma_{\\beta_p}$\"),\n",
    "    (\"beta_s_sd\", r\"$\\sigma_{\\beta_s}$\"),\n",
    "    (\"epsilon_sd\", r\"$\\sigma_{\\varepsilon}$\"),\n",
    "]\n",
    "\n",
    "param_specs = [\n",
    "    (c, l)\n",
    "    for c, l in param_specs\n",
    "    if c in df_plot.columns\n",
    "]\n",
    "\n",
    "x_specs = [\n",
    "    (\n",
    "        \"X_M\",\n",
    "        r\"$X_M=\\sqrt{N}\\,\\sigma_{\\log M}$\",\n",
    "        r\"X_M\",\n",
    "    ),\n",
    "    (\n",
    "        \"X_star\",\n",
    "        r\"$X_\\star=\\sqrt{N}\\,\\sigma_{[\\mathrm{Fe/H}]_\\star}$\",\n",
    "        r\"X_\\star\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "fig, axes = plt.subplots(\n",
    "    len(param_specs),\n",
    "    2,\n",
    "    figsize=(10.5, 3.6 * len(param_specs)),\n",
    "    squeeze=False,\n",
    ")\n",
    "\n",
    "for row, (sd_col, ylabel) in enumerate(param_specs):\n",
    "\n",
    "    for col_idx, (xcol, xlabel, xsym) in enumerate(x_specs):\n",
    "\n",
    "        ax = axes[row, col_idx]\n",
    "\n",
    "        x = df_plot[xcol].to_numpy(float)\n",
    "        y = df_plot[sd_col].to_numpy(float)\n",
    "\n",
    "        labels = df_plot[\"class_label\"].to_numpy(str)\n",
    "\n",
    "        scatter_fits(\n",
    "            ax,\n",
    "            x,\n",
    "            y,\n",
    "            labels,\n",
    "            ylabel,\n",
    "            xlabel,\n",
    "        )\n",
    "\n",
    "        # Keep HERMES-style linear axes.\n",
    "        for t in list(ax.texts):\n",
    "            t.remove()\n",
    "\n",
    "        m = (\n",
    "            np.isfinite(x) &\n",
    "            np.isfinite(y) &\n",
    "            (x > 0) &\n",
    "            (y > 0)\n",
    "        )\n",
    "\n",
    "        b_exp, b_err = _pl_fit_unc(\n",
    "            x[m],\n",
    "            y[m],\n",
    "        )\n",
    "\n",
    "        sym = ylabel.strip().strip(\"$\")\n",
    "\n",
    "        ann = (\n",
    "            rf\"${sym} \\propto \"\n",
    "            rf\"{xsym}^{{{b_exp:.2f}\\pm{b_err:.2f}}}$\"\n",
    "        )\n",
    "\n",
    "        ax.text(\n",
    "            0.05,\n",
    "            0.95,\n",
    "            ann,\n",
    "            transform=ax.transAxes,\n",
    "            fontsize=11,\n",
    "            va=\"top\",\n",
    "        )\n",
    "\n",
    "    add_legend(axes[row, 0], df_plot)\n",
    "\n",
    "fig.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "    \"sigma_vs_XM_Xstar_HERMES_style.pdf\",\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "plt.show()"
   ]
