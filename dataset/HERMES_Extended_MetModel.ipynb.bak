      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Mean posterior SD by class and N:\n",
      "\n",
      "$\\sigma_{\\alpha}$:\n",
      "N               50      80      150     200     250     350     400     500     600\n",
      "class_label                                                                        \n",
      "S1           0.0731  0.0515  0.0388  0.0324  0.0297  0.0254  0.0232  0.0210  0.0192\n",
      "S2           0.0677  0.0505  0.0352  0.0318  0.0285  0.0233  0.0222  0.0203  0.0179\n",
      "S3           0.0624  0.0441  0.0338  0.0297  0.0267  0.0224  0.0209     NaN     NaN\n",
      "S4           0.0578  0.0495  0.0358  0.0305     NaN     NaN     NaN     NaN     NaN\n",
      "\n",
      "$\\sigma_{\\beta_p}$:\n",
      "N               50      80      150     200     250     350     400     500     600\n",
      "class_label                                                                        \n",
      "S1           0.1023  0.0734  0.0523  0.0449  0.0416  0.0338  0.0316  0.0279  0.0258\n",
      "S2           0.1515  0.1074  0.0708  0.0659  0.0592  0.0478  0.0465  0.0418  0.0374\n",
      "S3           0.2189  0.1693  0.1246  0.1119  0.1029  0.0837  0.0769     NaN     NaN\n",
      "S4           0.2527  0.2290  0.1552  0.1345     NaN     NaN     NaN     NaN     NaN\n",
      "\n",
      "$\\sigma_{\\beta_s}$:\n",
      "N               50      80      150     200     250     350     400     500     600\n",
      "class_label                                                                        \n",
      "S1           0.4750  0.3084  0.2226  0.2018  0.1736  0.1451  0.1372  0.1235  0.1109\n",
      "S2           0.4237  0.3106  0.2296  0.2035  0.1786  0.1458  0.1410  0.1243  0.1139\n",
      "S3           0.4077  0.3126  0.2408  0.2050  0.1838  0.1530  0.1423     NaN     NaN\n",
      "S4           0.4940  0.3854  0.2831  0.2332     NaN     NaN     NaN     NaN     NaN\n",
      "\n",
      "$\\sigma_{\\varepsilon}$:\n",
      "N               50      80      150     200     250     350     400     500     600\n",
      "class_label                                                                        \n",
      "S1           0.0675  0.0482  0.0353  0.0294  0.0265  0.0223  0.0205  0.0189  0.0168\n",
      "S2           0.0640  0.0481  0.0334  0.0286  0.0263  0.0218  0.0207  0.0183  0.0166\n",
      "S3           0.0641  0.0452  0.0350  0.0305  0.0269  0.0224  0.0206     NaN     NaN\n",
      "S4           0.0639  0.0512  0.0375  0.0313     NaN     NaN     NaN     NaN     NaN\n"
